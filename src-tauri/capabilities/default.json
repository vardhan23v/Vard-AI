{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. The WebView gets no direct shell or filesystem access; all agent work goes through the sidecar.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "vscode://file/*"
        }
      ]
    }
  ]
}
