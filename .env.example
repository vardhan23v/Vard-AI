# Firebase web app config (Project settings → Your apps). Public identifiers, safe to ship.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth client of type "Desktop app", in the same Google Cloud project as Firebase.
# Google treats a desktop client's secret as non-confidential; PKCE protects the sign-in.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
